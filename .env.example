# OpenRobo Environment Configuration Template

# General Environment Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=development_only_secret_key_change_in_production_32_bytes

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=openrobo
POSTGRES_PASSWORD=openrobo_dev_password
POSTGRES_DB=openrobo_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://openrobo:openrobo_dev_password@localhost:5432/openrobo_db

# Web Application Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
