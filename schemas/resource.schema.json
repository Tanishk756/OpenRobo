{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRobo Resource",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "license": {
      "type": "object"
    },
    "robotics_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platforms": {
      "type": "object"
    },
    "dependencies": {
      "type": "array"
    },
    "hardware": {
      "type": "object"
    },
    "simulation": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
